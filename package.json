  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:azure": "prisma generate --schema=./prisma/schema.sqlserver.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "react-scripts test",
    "db:generate": "prisma generate",
    "db:generate:prod": "prisma generate --schema=./prisma/schema.sqlserver.prisma",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy --schema=./prisma/schema.sqlserver.prisma",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:studio:prod": "prisma studio --schema=./prisma/schema.sqlserver.prisma",
    "drawing": "tsx scripts/prize-drawing.ts",
    "drawing:test": "tsx scripts/prize-drawing.ts test",
    "drawing:conduct": "tsx scripts/prize-drawing.ts draw",
    "drawing:prod": "cross-env NODE_ENV=production tsx scripts/prize-drawing.ts draw",
    "drawing:prod:test": "cross-env NODE_ENV=production tsx scripts/prize-drawing.ts test"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "cross-env": "^10.0.0",
    "tsx": "^4.20.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
